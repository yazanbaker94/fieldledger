{
  "name": "fieldledger",
  "version": "1.0.1",
  "private": true,
  "type": "module",
  "description": "An interactive construction timecard approval and labour costing demo.",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "dev:api": "tsx watch --env-file-if-exists=.env server/index.ts",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && vite build",
    "start": "tsx --env-file-if-exists=.env server/index.ts",
    "test": "tsx --env-file-if-exists=.env --test server/*.test.ts",
    "test:browser": "playwright test",
    "screenshots": "playwright test --grep screenshots"
  },
  "dependencies": {
    "csv-parse": "^7.0.3",
    "express": "^5.3.0",
    "lucide-react": "^1.68.0",
    "pg": "^8.23.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tsx": "^4.23.15",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1",
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "typescript": "^5.9.3",
    "vite": "^8.3.5"
  }
}
